# Copy to /var/www/tiwater/.env.production on the droplet. Vite bakes these at build time.
# A change here requires a rebuild (the DigitalOcean workflow does that on each push).
# Do not commit the filled file.

# Parallel period (DNS for tiwater.mx still points at Azure):
VITE_API_BASE_URL=https://staging.tiwater.mx/api/v1.0
# At DNS cutover, change the line above to:
# VITE_API_BASE_URL=https://tiwater.mx/api/v1.0

# Optional. The app appends /tiwater when this is unset.
# VITE_API_BASE_URL_TIWATER=

# Must match TIWATER_API_KEY in TI_water_api/.env (the Azure App Service value).
VITE_TIWATER_API_KEY=
VITE_USE_MOCK_API=false
