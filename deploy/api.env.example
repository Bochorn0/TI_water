# Copy to /var/www/tiwater/TI_water_api/.env on the droplet. Never commit the copy.
# Values come from Azure App Service tiwatermx-api → Configuration → Application settings,
# except the database block below (local Postgres, SSL off).

PORT=3009
SECRET_KEY=
TIWATER_API_KEY=
TRUST_PROXY=1

# Same database on both pools. Password is /root/tiwater-db-password after bootstrap.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tiwatermx
POSTGRES_USER=tiwater
POSTGRES_PASSWORD=
POSTGRES_SSL=false

POSTGRES_TIWATER_HOST=localhost
POSTGRES_TIWATER_PORT=5432
POSTGRES_TIWATER_DB=tiwatermx
POSTGRES_TIWATER_USER=tiwater
POSTGRES_TIWATER_PASSWORD=
POSTGRES_TIWATER_SSL=false

FRONTEND_URL=https://tiwater.mx
TIWATER_PUBLIC_ORIGIN=https://tiwater.mx
SITE_ORIGIN=https://tiwater.mx

# Keep the provider already set on App Service. Fill only that block.
# EMAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=tiwater.mx
# MAILGUN_FROM_EMAIL=soporte@tiwater.mx
# MAILGUN_FROM_NAME=TI Water
# MAILGUN_REGION=
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_FROM_NAME=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Leave EMAIL_DISABLED unset in production.

# Copy unchanged from App Service if they are set there.
# TIWATER_QUOTE_LUGAR=
# TIWATER_QUOTE_TRADE_MARK=
# TIWATER_QUOTE_LEGAL_NAME=
# TIWATER_QUOTE_RFC=
# TIWATER_QUOTE_FOOTER_LEGAL=
# TIWATER_EMAIL_REPLY_TO=
